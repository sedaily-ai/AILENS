erDiagram
  pipeline_runs {
    bigserial id PK
    varchar(64) pipeline_name "frontpage_auto · mustknow_auto"
    varchar(32) trigger_source "기본 eventbridge"
    varchar(16) status "success · partial · failed · 기본 success"
    integer created_count "기본 0"
    integer skipped_count "기본 0"
    integer failed_count "기본 0"
    text ecs_task_arn "없으면 CloudWatch 추적 불가 · 미구현"
    timestamptz started_at "기본 now()"
    timestamptz finished_at
  }
  pipeline_run_items {
    bigserial id PK
    bigint run_id FK "NOT NULL · CASCADE"
    varchar(32) article_no "FK 없음 · 로그 성격"
    varchar(16) result "NOT NULL · created · skipped · failed"
    varchar(64) reason "예: content_unchanged"
  }
  lens_candidates {
    bigserial id PK
    varchar(32) article_no FK "NOT NULL · CASCADE · 채점 대상"
    bigint run_id FK "SET NULL · 어느 실행"
    numeric score "정밀도 4·2"
    numeric threshold "정밀도 4·2"
    boolean is_selected "기본 FALSE"
    timestamptz scored_at "기본 now()"
  }
  ai_usage_logs {
    bigserial id PK "PK 일부"
    varchar(16) purpose "NOT NULL · generate · chat · classify"
    bigint rendition_id "FK 없음 · 배타 · 정확히 하나만 채워짐"
    bigint message_id "FK 없음 · 배타"
    bigint candidate_id "FK 없음 · 배타"
    varchar(255) model_id "NOT NULL · inference profile ARN"
    varchar(16) tier "익명 사용자 비용 분리"
    integer input_tokens "기본 0"
    integer output_tokens "기본 0"
    integer cache_write_tokens "따로 센다 · 기본 0"
    integer cache_read_tokens "따로 센다 · 기본 0"
    numeric cost_usd "정밀도 12·6 · 전 테이블 통일 · 기본 0"
    varchar(16) outcome "success · refused · failed · 기본 success"
    text error_message
    integer latency_ms
    timestamptz occurred_at PK "파티션 키 · 월별(2026_09, 2026_10)"
  }
  prompts {
    smallserial id PK
    varchar(64) name UK
    varchar(32) category
  }
  prompt_versions {
    bigserial id PK
    smallint prompt_id FK "NOT NULL · CASCADE · UNIQUE 짝: prompt_id + version"
    integer version "NOT NULL"
    text content "NOT NULL"
    boolean is_active "기본 FALSE · 부분 UNIQUE · 프롬프트당 활성 1개"
    varchar(32) created_by FK "SET NULL"
    timestamptz created_at "기본 now()"
  }
  feature_flags {
    varchar(64) name PK "기능 스위치"
    boolean is_enabled "기본 FALSE"
    timestamptz updated_at "기본 now()"
  }
  audit_logs {
    bigserial id PK
    varchar(64) flag_name FK "SET NULL · 어느 플래그"
    varchar(32) editor_no FK "SET NULL · 누가"
    text before_value
    text after_value
    timestamptz changed_at "기본 now()"
  }
  incidents {
    varchar(64) id PK
    varchar(64) mechanism "NOT NULL"
    varchar(16) status "open · resolved · 기본 open · 부분 인덱스"
    varchar(16) severity
    text title
    jsonb detail "기본 {}"
    timestamptz opened_at "기본 now()"
    timestamptz resolved_at
  }

  pipeline_runs ||--o{ pipeline_run_items : "run_id · CASCADE"
  pipeline_runs ||..o{ lens_candidates : "run_id · SET NULL"
  pipeline_runs ||..o{ publications : "run_id · SET NULL · 뒤늦은 FK"
  pipeline_runs ||..o{ glossary_terms : "run_id · SET NULL · 뒤늦은 FK"
  pipeline_runs ||..o{ quizzes : "run_id · SET NULL · 뒤늦은 FK"
  articles ||--o{ lens_candidates : "article_no · CASCADE"
  prompts ||--o{ prompt_versions : "prompt_id · CASCADE"
  editors ||..o{ prompt_versions : "created_by · SET NULL"
  feature_flags ||..o{ audit_logs : "flag_name · SET NULL"
  editors ||..o{ audit_logs : "editor_no · SET NULL"

