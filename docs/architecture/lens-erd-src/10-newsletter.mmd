erDiagram
  newsletters {
    smallserial id PK
    smallint section_id FK "NOT NULL · UNIQUE · 지면당 하나 · 1면만 발송"
    varchar(128) name "NOT NULL"
    boolean is_active "기본 TRUE"
  }
  subscriptions {
    bigserial id PK
    smallint newsletter_id FK "NOT NULL · CASCADE · UNIQUE 짝: newsletter_id + email"
    varchar(64) user_id FK "SET NULL · NULL 허용 · 이메일만 남긴 구독자"
    varchar(255) email "NOT NULL"
    timestamptz started_at "구독 시작 · 기본 now()"
    timestamptz cancelled_at "해지 · 부분 인덱스 IS NULL"
    varchar(64) unsubscribe_token "NOT NULL · UNIQUE"
  }
  newsletter_sends {
    bigserial id PK "발송 회차"
    smallint newsletter_id FK "NOT NULL · CASCADE · UNIQUE 짝: newsletter_id + send_date"
    bigint publication_id FK "SET NULL"
    date send_date "NOT NULL"
    integer target_count "기본 0"
    integer success_count "기본 0"
    integer failure_count "기본 0"
    timestamptz started_at "기본 now()"
    timestamptz finished_at
  }
  newsletter_send_items {
    bigserial id PK
    bigint send_id FK "NOT NULL · CASCADE"
    bigint subscription_id FK "SET NULL"
    varchar(255) email "NOT NULL · 복사 · 구독이 지워져도 남는다"
    varchar(16) result "sent · failed · bounced · 기본 sent"
    timestamptz sent_at
    timestamptz opened_at "오픈"
  }

  sections ||--o| newsletters : "section_id · UNIQUE"
  newsletters ||--o{ subscriptions : "newsletter_id"
  newsletters ||--o{ newsletter_sends : "newsletter_id · CASCADE"
  publications ||..o{ newsletter_sends : "publication_id · SET NULL"
  newsletter_sends ||--o{ newsletter_send_items : "send_id · CASCADE"
  subscriptions ||..o{ newsletter_send_items : "subscription_id · SET NULL"
  users ||--o{ subscriptions : "user_id · CASCADE"
