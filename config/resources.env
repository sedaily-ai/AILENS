# AI LENS 운영 리소스 이름·ID 정본. 배포 스크립트는 이 파일을 source 하고, 값을 스크립트에 복사하지 않는다.
# 비밀 값은 넣지 않는다(이름·ID만). 새 값은 여기에 먼저 추가한다.
AWS_ACCOUNT_ID="887078546492"
AWS_REGION="us-east-1"

# 사이트(ailens.sedaily.ai) CloudFront
SERVICE_CF_DIST_ID="E1QS7PY350VHF6"

# 관리자 콘솔 정적 호스팅
ADMIN_S3_BUCKET="sedaily-mbti-admin-frontend-dev"
ADMIN_CF_DIST_ID="E1MITYI58DB9UW"

# lens-cms-api EC2(PM2)
CMS_API_INSTANCE_ID="i-0e3d04bdb01584833"

# 나의 LENS 공개 계정 API (신규 함수 생성 전 정본 등록, 운영 생성 미실행)
ACCOUNT_DASHBOARD_FUNCTION="sedaily-lens-dashboard-dev"
ACCOUNT_ARCHIVE_FUNCTION="sedaily-mbti-archive-dev"
SERVICE_HTTP_API_ID="chzwwtjtgk"
SERVICE_HTTP_API_STAGE="dev"
SERVICE_LAMBDA_PACKAGE_BUCKET="sedaily-mbti-lambda-packages-dev"
CMS_RELEASE_BUCKET="ailens-ssr-releases"

# 타임머신 1면 원본 이미지(timemachine-data). 2026-11-03 버킷 생성.
# 사이트 CloudFront(SERVICE_CF_DIST_ID)의 /timemachine-newspaper/* 경로가 이 버킷의 timemachine-newspaper/ 아래를 읽는다. 규격: timemachine-data/261103_타임머신_1면이미지_인수규격.md
TIMEMACHINE_NEWSPAPER_BUCKET="sedaily-lens-timemachine-newspaper"
# 타임머신 신문 1면 일일 수집(e-Paper 최신호 → 위 버킷). Lambda + EventBridge 매시간. 역할·규칙 이름은 이 값에서 파생. timemachine-data/aws/provision.sh
TIMEMACHINE_CAPTURE_FUNCTION="sedaily-lens-timemachine-newspaper-capture"

# 기존 서비스 프론트 ECS
SERVICE_FRONTEND_ECS_CLUSTER="sedaily-lens-frontend"
SERVICE_FRONTEND_ECS_SERVICE="sedaily-lens-frontend"
