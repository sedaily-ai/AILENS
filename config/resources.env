# AI LENS 운영 리소스 이름·ID 정본. 배포 스크립트는 이 파일을 source 하고, 값을 스크립트에 복사하지 않는다.
# 비밀 값은 넣지 않는다(이름·ID만). 새 값은 여기에 먼저 추가한다.
AWS_ACCOUNT_ID="887078546492"
AWS_REGION="us-east-1"

# 사이트(ailens.sedaily.ai) CloudFront
SERVICE_CF_DIST_ID="E1QS7PY350VHF6"

# 관리자 콘솔 정적 호스팅
ADMIN_S3_BUCKET="sedaily-mbti-admin-frontend-dev"
ADMIN_CF_DIST_ID="E1MITYI58DB9UW"

# lens-cms-api EC2(PM2)
CMS_API_INSTANCE_ID="i-0e3d04bdb01584833"

# 나의 LENS 공개 계정 API (신규 함수 생성 전 정본 등록, 운영 생성 미실행)
ACCOUNT_DASHBOARD_FUNCTION="sedaily-lens-dashboard-dev"
ACCOUNT_ARCHIVE_FUNCTION="sedaily-mbti-archive-dev"
SERVICE_HTTP_API_ID="chzwwtjtgk"
SERVICE_HTTP_API_STAGE="dev"
SERVICE_LAMBDA_PACKAGE_BUCKET="sedaily-mbti-lambda-packages-dev"
CMS_RELEASE_BUCKET="ailens-ssr-releases"

# 타임머신 1면 원본 이미지(timemachine-data). 2026-11-03 버킷 생성.
# 사이트 CloudFront(SERVICE_CF_DIST_ID)의 /timemachine-newspaper/* 경로가 이 버킷의 timemachine-newspaper/ 아래를 읽는다. 규격: timemachine-data/261103_타임머신_1면이미지_인수규격.md
TIMEMACHINE_NEWSPAPER_BUCKET="sedaily-lens-timemachine-newspaper"
# 타임머신 신문 1면 일일 수집(e-Paper 최신호 → 위 버킷). Lambda + EventBridge 매시간. 역할·규칙 이름은 이 값에서 파생. timemachine-data/aws/provision.sh
TIMEMACHINE_CAPTURE_FUNCTION="sedaily-lens-timemachine-newspaper-capture"
# 타임머신 신문 네이버 1면 목록 일일 수집·누락 목록(위 버킷 index/v1/ 연도 파일에 이어 붙임, ops/status/missing.json). Lambda + EventBridge 매시간. NAVER_DAILY=on 일 때만 네이버에 요청한다. timemachine-data/aws/provision_daily.sh
TIMEMACHINE_DAILY_FUNCTION="sedaily-lens-timemachine-newspaper-daily"
# 빅카인즈 날짜별 조회 및 DynamoDB 캐시 함수
TIMEMACHINE_FRONT_FUNCTION="sedaily-mbti-time-machine-dev"
TIMEMACHINE_CACHE_TABLE="sedaily-mbti-articles-dev"
# 위 두 함수의 오류·누락 알림이 가는 SNS 토픽(이메일 구독은 provision_daily.sh 에 ALERT_EMAIL 을 주면 만든다).
TIMEMACHINE_ALERT_TOPIC="sedaily-lens-timemachine-newspaper-alerts"

# 기존 서비스 프론트 ECS
SERVICE_FRONTEND_ECS_CLUSTER="sedaily-lens-frontend"
SERVICE_FRONTEND_ECS_SERVICE="sedaily-lens-frontend"

# PRISM 매일 자동 제작(2026-11-05). EventBridge가 9:00~12:55 KST 5분마다 admin Lambda를 {"_prism_auto":{}}로 부른다.
# 끄기: aws events disable-rule --name "$PRISM_AUTO_RULE". 코드: admin/backend/routes/prism_schedule.py
ADMIN_API_FUNCTION="sedaily-mbti-admin-api-dev"
PRISM_AUTO_RULE="sedaily-lens-prism-auto"
PRISM_NOTIFY_TOPIC="prism-batch-notify"

# 1면 웹툰 인스타그램(@lens.sedaily) 자동 게시(2026-11-20). EventBridge 매일 08:00 KST → Lambda.
# 끄기: aws events disable-rule --name "$INSTAGRAM_RULE". 코드: pipelines/instagram_auto/
INSTAGRAM_FUNCTION="sedaily-lens-instagram-webtoon"
INSTAGRAM_ROLE="sedaily-lens-instagram-webtoon-role"
INSTAGRAM_RULE="sedaily-lens-instagram-webtoon-daily"
INSTAGRAM_TOKEN_PARAM="/sedaily-lens/instagram/token"
INSTAGRAM_NOTIFY_TOPIC="ailens-ops-alerts"

# 1면 기사 사진 카드 인스타그램(@lens.sedaily) 자동 게시(2026-11-24). EventBridge 09·12·15·18시 KST → Lambda(1회 1건).
# 끄기: aws events disable-rule --name "$INSTAGRAM_SINGLE_RULE". 코드: pipelines/instagram_single/ (토큰·알림 토픽은 위와 공용)
INSTAGRAM_SINGLE_FUNCTION="sedaily-lens-instagram-single"
INSTAGRAM_SINGLE_ROLE="sedaily-lens-instagram-single-role"
INSTAGRAM_SINGLE_RULE="sedaily-lens-instagram-single-4x"
INSTAGRAM_SINGLE_MODEL_PROFILE="lens-instagram-single-sonnet-5"

# 서울경제 공식 인스타(@seoul_economic) 지면 1면·연예 사진 카드 자동 게시(2026-11-26 설치, 규칙은 DISABLED로 시작).
# EventBridge 1면 06·07·08·12·14시 / 연예 10·16·19·21시 KST → Lambda(1회 1건). 코드: pipelines/instagram_seoul_economic/
# 토큰은 "서울경제 LENS" 포트폴리오 시스템 사용자 seoul-economic-publisher 전용(LENS 토큰과 별개). Slack 알림 없음.
INSTAGRAM_SEOUL_FUNCTION="sedaily-instagram-seoul-economic"
INSTAGRAM_SEOUL_ROLE="sedaily-instagram-seoul-economic-role"
INSTAGRAM_SEOUL_RULE_FRONT="sedaily-instagram-seoul-economic-front"
INSTAGRAM_SEOUL_RULE_ENT="sedaily-instagram-seoul-economic-ent"
INSTAGRAM_SEOUL_RULE_COJUBOO="sedaily-instagram-seoul-economic-cojuboo"   # @co.ju.boo 09·11·13·15·17시(같은 Lambda·토큰)
INSTAGRAM_SEOUL_MODEL_PROFILE="seoul-economic-instagram-sonnet-5"
INSTAGRAM_SEOUL_TOKEN_PARAM="/sedaily-lens/instagram/token-seoul-economic"
