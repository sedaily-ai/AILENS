{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DynamoDBAdmin",
            "Effect": "Allow",
            "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan"
            ],
            "Resource": [
                "arn:aws:dynamodb:us-east-1:887078546492:table/sedaily-mbti-admin-config-dev",
                "arn:aws:dynamodb:us-east-1:887078546492:table/sedaily-mbti-admin-prompts-dev",
                "arn:aws:dynamodb:us-east-1:887078546492:table/sedaily-mbti-newsletter-subscribers-dev"
            ]
        },
        {
            "Sid": "SSMAdmin",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter",
                "ssm:PutParameter"
            ],
            "Resource": "arn:aws:ssm:us-east-1:887078546492:parameter/sedaily-mbti/admin/*"
        },
        {
            "Sid": "KMSDecryptForSSM",
            "Effect": "Allow",
            "Action": "kms:Decrypt",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "kms:ViaService": "ssm.us-east-1.amazonaws.com"
                }
            }
        },
        {
            "Sid": "EventBridgeListRules",
            "Effect": "Allow",
            "Action": "events:ListRules",
            "Resource": "*"
        },
        {
            "Sid": "EventBridgeRuleAdmin",
            "Effect": "Allow",
            "Action": [
                "events:DescribeRule",
                "events:ListTargetsByRule",
                "events:PutRule",
                "events:EnableRule",
                "events:DisableRule"
            ],
            "Resource": "arn:aws:events:us-east-1:887078546492:rule/sedaily-mbti-*"
        },
        {
            "Sid": "CloudWatchMetrics",
            "Effect": "Allow",
            "Action": [
                "cloudwatch:GetMetricStatistics",
                "cloudwatch:GetMetricData",
                "cloudwatch:ListMetrics"
            ],
            "Resource": "*"
        },
        {
            "Sid": "Logs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:us-east-1:887078546492:*"
        }
    ]
}
