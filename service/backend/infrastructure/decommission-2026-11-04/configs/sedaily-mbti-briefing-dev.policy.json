{
  "Version": "2012-10-17",
  "Id": "default",
  "Statement": [
    {
      "Sid": "EventBridgeDailyBriefing",
      "Effect": "Allow",
      "Principal": {
        "Service": "events.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:887078546492:function:sedaily-mbti-briefing-dev",
      "Condition": {
        "ArnLike": {
          "AWS:SourceArn": "arn:aws:events:us-east-1:887078546492:rule/sedaily-mbti-daily-briefing"
        }
      }
    },
    {
      "Sid": "EventBridgeAfternoonBriefing",
      "Effect": "Allow",
      "Principal": {
        "Service": "events.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:887078546492:function:sedaily-mbti-briefing-dev",
      "Condition": {
        "ArnLike": {
          "AWS:SourceArn": "arn:aws:events:us-east-1:887078546492:rule/sedaily-mbti-afternoon-briefing"
        }
      }
    }
  ]
}