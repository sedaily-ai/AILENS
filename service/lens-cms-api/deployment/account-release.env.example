# /tmp/lens-release.env(권한 600)에 복사하고 실제 승인된 값을 비밀 저장소에서 공급한다.
# PG*는 마이그레이션 역할, LENS_PG_*는 앱 역할. 같은 대상 DB인지 확인한다.
# (선택) 빈 값으로 두면 AWS CLI가 이름 없는 프로필을 찾으므로, 쓸 때만 주석을 풀고 값을 넣는다.
# AWS_PROFILE=
PGHOST=
# (선택) 기본 5432. 다른 포트일 때만 주석을 풀고 값을 넣는다.
# PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
LENS_PG_HOST=
LENS_PG_DATABASE=
LENS_PG_USER=
LENS_PG_PASSWORD=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CMS_API_URL=
