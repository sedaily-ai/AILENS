lambda-build-v2/
lambda-build-admin/
lambda_package.zip
lambda_package_v2.zip
lambda_package_admin.zip

# admin/backend 배포 스크립트의 pip 설치 캐시(2026-09-29) — requirements.txt
# 해시가 안 바뀌면 재사용해서 매 배포마다 전체 재설치를 피한다
# (lens-cms-api/deploy.sh의 .requirements.sha256 패턴과 동일 원칙).
admin/backend/.pip-cache-admin/

# Android TWA (mobile/) — 서명 키스토어(비밀값) + Gradle/빌드 산출물.
# 전체 디렉터리를 통째로 제외한다(bubblewrap 생성물이라 재현 가능, 커밋 불필요).
mobile/

# ERD 다이어그램 이미지 — 커밋하지 않는다.
# docs/architecture/lens-erd-src/*.mmd 가 소스이고, 이미지는 매번 좌표가 바뀌는
# 생성물이라 텍스트 diff 가 안 되면서 히스토리에만 수 MB씩 쌓인다.
# 필요할 때 lens-postgres-erd.html 의 [SVG 저장] · [PNG 저장] 버튼으로 뽑아 쓴다.
docs/architecture/lens-erd-img/

