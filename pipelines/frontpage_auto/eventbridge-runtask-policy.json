{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:us-east-1:887078546492:task-definition/sedaily-lens-frontpage-auto:*",
      "Condition": {
        "ArnLike": {"ecs:cluster": "arn:aws:ecs:us-east-1:887078546492:cluster/sedaily-lens-frontpage-auto"}
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::887078546492:role/sedaily-lens-frontpage-auto-task-role",
        "arn:aws:iam::887078546492:role/sedaily-lens-frontpage-auto-execution-role"
      ]
    }
  ]
}
