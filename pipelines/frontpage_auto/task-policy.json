{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadNewsXml",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::sedaily-news-xml-storage/daily-xml/*"
    },
    {
      "Sid": "MediaBucketReadWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::sedaily-mbti-cms-media-dev/*"
    },
    {
      "Sid": "WebtoonGpuControl",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances"],
      "Resource": "*"
    },
    {
      "Sid": "WebtoonGpuStartStop",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances"],
      "Resource": "arn:aws:ec2:ap-northeast-2:887078546492:instance/i-02313c8c8285f9d91"
    },
    {
      "Sid": "WebtoonGpuSsm",
      "Effect": "Allow",
      "Action": ["ssm:DescribeInstanceInformation", "ssm:GetCommandInvocation"],
      "Resource": "*"
    },
    {
      "Sid": "WebtoonGpuSsmSendCommand",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand"],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:887078546492:instance/i-02313c8c8285f9d91",
        "arn:aws:ssm:ap-northeast-2::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "WebtoonGpuBucketReadWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::sedaily-webtoon-ipadapter-887078546492/*"
    },
    {
      "Sid": "WebtoonGpuLockTable",
      "Effect": "Allow",
      "Action": ["dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:887078546492:table/sedaily-lens-gpu-lock-dev"
    },
    {
      "Sid": "LensCmsApiTokenRead",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": "arn:aws:ssm:us-east-1:887078546492:parameter/sedaily-mbti/admin/lens-cms-api-token"
    },
    {
      "Sid": "AdminPromptsRead",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:887078546492:table/sedaily-mbti-admin-prompts-dev"
    },
    {
      "Sid": "SecretsRead",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:887078546492:secret:sedaily-mbti/openai-api-key-*"
      ]
    },
    {
      "Sid": "PollySynthesizeSpeech",
      "Effect": "Allow",
      "Action": ["polly:SynthesizeSpeech"],
      "Resource": "*"
    },
    {
      "Sid": "RevalidateSecretRead",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": "arn:aws:ssm:us-east-1:887078546492:parameter/sedaily-mbti/ssr-revalidate-secret"
    },
    {
